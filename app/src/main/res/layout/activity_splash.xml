<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:gravity="center"
    android:orientation="vertical">

    <!-- Mic ring glow -->
    <FrameLayout
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginBottom="28dp">

        <View
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:alpha="0.25"
            android:background="@drawable/bg_mic_ring" />

        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic_ring_solid"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙"
                android:textSize="40sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pravah AI"
        android:textColor="@color/white"
        android:textSize="34sp"
        android:textStyle="bold"
        android:letterSpacing="0.03" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Meeting Recorder"
        android:textColor="@color/primary"
        android:textSize="15sp"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Your AI meeting intelligence"
        android:textColor="@color/text_hint"
        android:textSize="12sp" />

</LinearLayout>
