<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_gradient_header"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_detail_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_detail_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_filename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tab chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card_premium"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/detail_chip_summary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip_selector"
            android:gravity="center"
            android:text="📋 Summary"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_chip_tasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_chip_selector"
            android:gravity="center"
            android:text="✅ Tasks"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_chip_transcript"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_chip_selector"
            android:gravity="center"
            android:text="📝 Transcript"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="24dp">

            <!-- Summary card -->
            <LinearLayout
                android:id="@+id/detail_summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_premium"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" android:text="MEETING SUMMARY"
                    android:textColor="@color/secondary" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.08" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginBottom="14dp" android:background="@color/divider" />
                <TextView android:id="@+id/detail_tv_summary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:lineSpacingMultiplier="1.8"
                    android:textColor="@color/text_primary" android:textIsSelectable="true"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Tasks card -->
            <LinearLayout
                android:id="@+id/detail_tasks_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_premium"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" android:text="ACTION ITEMS"
                    android:textColor="@color/accent_green" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.08" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginBottom="10dp" android:background="@color/divider" />
                <LinearLayout android:id="@+id/detail_tasks_container"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Transcript card -->
            <LinearLayout
                android:id="@+id/detail_transcript_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_premium"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" android:text="FULL TRANSCRIPT"
                    android:textColor="@color/primary" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.08" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginBottom="12dp" android:background="@color/divider" />
                <TextView android:id="@+id/detail_tv_transcript" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:lineSpacingMultiplier="1.5"
                    android:textColor="@color/text_secondary" android:textIsSelectable="true"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
