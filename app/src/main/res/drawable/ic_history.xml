<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        History icon: nearly-complete counter-clockwise circle (300°),
        gap at top-right, open chevron arrowhead at 12 o'clock pointing left
        (direction of CCW motion), clock hands showing ~10:10.

        Circle center (12,12), radius 8.
        Arc start: 2 o'clock = (12 + 8·sin60°, 12 - 8·cos60°) = (18.93, 8)
        Arc end  : 12 o'clock = (12, 4)
        Sweep    : 300° CCW, large-arc-flag=1, sweep-flag=0
    -->

    <!-- 300° CCW arc from 2 o'clock to 12 o'clock -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/text_secondary"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M 18.93,8 A 8,8 0 1 0 12,4" />

    <!-- Open chevron arrowhead at 12 o'clock, pointing LEFT (CCW direction) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/text_secondary"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 14.5,2 L 12,4 L 14.5,6" />

    <!-- Minute hand pointing to 12 (straight up) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/text_secondary"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M 12,12 L 12,7.5" />

    <!-- Hour hand pointing to 10 o'clock -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/text_secondary"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M 12,12 L 8.3,9.5" />

    <!-- Center dot -->
    <path
        android:fillColor="@color/text_secondary"
        android:pathData="M 11.2,12 A 0.8,0.8 0 1 0 12.8,12 A 0.8,0.8 0 1 0 11.2,12 Z" />

</vector>
