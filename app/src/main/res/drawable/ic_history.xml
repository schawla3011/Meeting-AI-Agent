<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        Counter-clockwise circular arrow:
        Arc from 4 o'clock (19,16) sweeping CCW 240° to 12 o'clock (12,4).
        Large arc (>180°), sweep=0 = counter-clockwise in SVG/VectorDrawable.
    -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/text_secondary"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M 19,16 A 8,8 0 1 0 12,4" />

    <!-- Arrowhead at 12 o'clock pointing LEFT (direction of CCW motion at the top) -->
    <path
        android:fillColor="@color/text_secondary"
        android:pathData="M 10,4 L 13.5,1.8 L 13.5,6.2 Z" />

    <!-- Clock hour hand (~10 o'clock) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/text_secondary"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M 12,12 L 9.8,10.3" />

    <!-- Clock minute hand (pointing to 12) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/text_secondary"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M 12,12 L 12,8.5" />

    <!-- Center dot -->
    <path
        android:fillColor="@color/text_secondary"
        android:pathData="M 11.2,12 A 0.8,0.8 0 1 0 12.8,12 A 0.8,0.8 0 1 0 11.2,12 Z" />

</vector>
